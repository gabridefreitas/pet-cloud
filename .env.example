POSTGRES_DB=petcloud
POSTGRES_USER=petcloud
POSTGRES_PASSWORD=petcloud_local
# Optional full API connection URI; blank uses POSTGRES_* and the local db service.
# Deployment credentials/TLS belong in runtime secret injection, never frontend args.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=CHANGE-ME-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS
JWT_EXP_MINUTES=1440
S3_BUCKET=
AWS_REGION=us-east-1

# Public frontend build setting. Change it before building, not at container runtime.
VITE_API_URL=http://localhost:8000

# Optional browser RUM. Public monitor settings only; never add AWS access keys here.
# Leave disabled for local use. Missing/invalid settings also keep telemetry off.
VITE_RUM_ENABLED=false
VITE_RUM_APP_MONITOR_ID=
VITE_RUM_REGION=
VITE_RUM_IDENTITY_POOL_ID=
VITE_RUM_APP_VERSION=0.1.0
