# PostgreSQL
DATABASE_URL=postgresql://petcloud:petcloud_local@localhost:5432/petcloud

# Frontend origins allowed by CORS (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Authentication: replace with at least 32 random bytes before deployment
JWT_SECRET=CHANGE-ME-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS
JWT_EXP_MINUTES=1440

# AWS S3 pet-photo storage
S3_BUCKET=
AWS_REGION=us-east-1
# Locally boto3 uses the default AWS credential chain; in AWS use an IAM role.
