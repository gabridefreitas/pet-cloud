# PostgreSQL
DATABASE_URL=postgresql://petcloud:petcloud_local@localhost:5432/petcloud
# For an authorized remote deployment, add the required libpq TLS options to
# the URI (sslmode=verify-full and sslrootcert=/path/to/mounted/ca.pem).
# Process environment overrides this file; no Secrets Manager lookup is performed.

# Frontend origins allowed by CORS (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Authentication: replace with at least 32 random bytes before deployment
JWT_SECRET=CHANGE-ME-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS
JWT_EXP_MINUTES=1440

# Optional AWS S3 pet-photo storage; blank keeps AWS access disabled.
S3_BUCKET=
AWS_REGION=us-east-1
# Only when storage is enabled does boto3 use the default AWS credential chain.
# In AWS use an IAM role, not static access keys in this file.
